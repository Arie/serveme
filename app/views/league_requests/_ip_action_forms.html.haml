- { "ban-ip-form" => ban_ip_league_request_path, "dismiss-proxy-form" => dismiss_proxy_league_request_path, "toggle-shared-ip-form" => toggle_shared_ip_league_request_path }.each do |id, path|
  = form_tag path, method: :patch, id: id, class: "d-none" do
    = hidden_field_tag :search_ip, @league_request_params[:ip], id: nil
    = hidden_field_tag :search_steam_uid, @league_request_params[:steam_uid], id: nil
    = hidden_field_tag :search_reservation_ids, @league_request_params[:reservation_ids], id: nil
    = hidden_field_tag :search_cross_reference, @league_request_params[:cross_reference], id: nil
    = hidden_field_tag :search_include_vpn_results, @league_request_params[:include_vpn_results], id: nil
