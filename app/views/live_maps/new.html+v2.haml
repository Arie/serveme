- content_for(:title) { "Live STV map" }

%div{class: "flex items-center justify-between gap-4 my-6 flex-wrap"}
  %h1{class: "v2-page-title"} Live STV map

%p{class: "text-muted mb-4"}
  Watch any match from above: paste the server's SourceTV connect string, like
  %code connect 1.2.3.4:27020; password "tv"
  or its address and password, like
  %code 1.2.3.4:27020 tv

%p{class: "text-muted mb-4"}
  To play a demo, paste its demos.tf link, like
  %code https://demos.tf/1527264

= form_tag(live_map_path, method: :post, class: "flex flex-wrap items-center gap-2", data: { turbo: false }) do
  = text_field_tag :connect, params[:connect], class: "v2-input flex-1", placeholder: 'connect 1.2.3.4:27020; password "tv" or a demos.tf link', autocomplete: "off", required: true, autofocus: true
  = submit_tag "Watch", class: "v2-btn v2-btn-primary"
