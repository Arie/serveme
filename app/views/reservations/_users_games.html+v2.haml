%div{class: "v2-table-wrap"}
  %table{class: "v2-table"}
    %thead
      %tr
        %th Server
        %th From
        %th Until
        %th Reserved by
        %th Logs/demos
    %tbody
      - @users_games.each do |reservation|
        - server = reservation.server.decorate
        %tr
          %td= server.name
          %td{class: "font-mono text-muted whitespace-nowrap"}= I18n.l(reservation.starts_at, format: :short)
          %td{class: "font-mono text-muted whitespace-nowrap"}= I18n.l(reservation.ends_at, format: :short)
          %td{class: "text-muted"}= reservation.user.nickname
          %td
            %div{class: "flex flex-wrap items-center gap-1.5"}
              - if reservation.younger_than_cleanup_age? || reservation.zipfile.attached?
                = render 'reservations/zip_file_link', reservation: reservation
                - if reservation.user == current_user || current_admin
                  = link_to "logs.tf", reservation_log_uploads_path(reservation), title: "Upload the match logs to logs.tf", class: "v2-action text-success-text border-success/30 hover:bg-success/10"
              - else
                = link_to "logs.tf", reservation.logs_tf_url, title: "Search on logs.tf", class: "v2-action text-info border-info/40 hover:bg-info/10"
