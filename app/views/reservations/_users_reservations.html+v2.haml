%div{class: "v2-table-wrap"}
  %table{class: "v2-table"}
    %thead
      %tr
        %th Server
        %th From
        %th Until
        %th Actions
    %tbody
      - @users_reservations.each do |reservation|
        - reservation = reservation.decorate
        - row_tint = reservation.now? ? "v2-res-now" : (reservation.future? ? "v2-res-future" : "")
        %tr{class: row_tint}
          %td= reservation.server_name
          %td{class: "font-mono text-muted whitespace-nowrap"}= I18n.l(reservation.starts_at, format: :short)
          %td{class: "font-mono text-muted whitespace-nowrap"}= I18n.l(reservation.ends_at, format: :short)
          %td= render 'reservations/actions', reservation: reservation
