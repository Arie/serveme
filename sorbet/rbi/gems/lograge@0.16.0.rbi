  # pkg:gem/lograge#lib/lograge/formatters/helpers/safe_json.rb:64
  def normalize_object(object); end

  # pkg:gem/lograge#lib/lograge/formatters/helpers/safe_json.rb:71
  def to_utf8(string); end

