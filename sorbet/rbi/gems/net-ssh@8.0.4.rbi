# pkg:gem/net-ssh#lib/net/ssh/transport/ctr.rb:32
module Net::SSH::Transport::CTR
  class << self
    # pkg:gem/net-ssh#lib/net/ssh/transport/ctr.rb:33
    def extended(orig); end
  end
end

