  def set(values); end

  # The socket object that owns this state object.
  #
  # pkg:gem/net-ssh#lib/net/ssh/transport/state.rb:15
  def socket; end

  # pkg:gem/net-ssh#lib/net/ssh/transport/state.rb:79
  def update_cipher(data); end

