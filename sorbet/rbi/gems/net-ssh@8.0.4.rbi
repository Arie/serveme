Net::SSH::Transport::Algorithms::EXPLICIT_ONLY_ALGORITHMS = T.let(T.unsafe(nil), Hash)

# Pure-Ruby implementation of Stateful Decryption Counter(SDCTR) Mode
# for Block Ciphers. See RFC4344 for detail.
