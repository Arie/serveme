# These constants are used when requesting a pseudo-terminal (via
# Net::SSH::Connection::Channel#request_pty). The descriptions for each are
# taken directly from RFC 4254 ("The Secure Shell (SSH) Connection Protocol"),
# http://tools.ietf.org/html/rfc4254.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:8
module Net::SSH::Connection::Term; end

# 7 bit mode.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:161
Net::SSH::Connection::Term::CS7 = T.let(T.unsafe(nil), Integer)

# 8 bit mode.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:164
Net::SSH::Connection::Term::CS8 = T.let(T.unsafe(nil), Integer)

# Enable echoing.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:113
Net::SSH::Connection::Term::ECHO = T.let(T.unsafe(nil), Integer)

# Echo control characters as ^(Char).
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:134
Net::SSH::Connection::Term::ECHOCTL = T.let(T.unsafe(nil), Integer)

# Visually erase chars.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:116
Net::SSH::Connection::Term::ECHOE = T.let(T.unsafe(nil), Integer)

# Kill character discards current line.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:119
Net::SSH::Connection::Term::ECHOK = T.let(T.unsafe(nil), Integer)

# Visual erase for line kill.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:137
Net::SSH::Connection::Term::ECHOKE = T.let(T.unsafe(nil), Integer)

# Echo NL even if ECHO is off.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:122
Net::SSH::Connection::Term::ECHONL = T.let(T.unsafe(nil), Integer)

# Canonicalize input lines.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:106
Net::SSH::Connection::Term::ICANON = T.let(T.unsafe(nil), Integer)

# Map CR to NL on input.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:85
Net::SSH::Connection::Term::ICRNL = T.let(T.unsafe(nil), Integer)

# Enable extensions.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:131
Net::SSH::Connection::Term::IEXTEN = T.let(T.unsafe(nil), Integer)

# Ignore CR on input.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:82
Net::SSH::Connection::Term::IGNCR = T.let(T.unsafe(nil), Integer)

# The ignore parity flag. The parameter SHOULD be 0 if this flag is FALSE,
# and 1 if it is TRUE.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:67
Net::SSH::Connection::Term::IGNPAR = T.let(T.unsafe(nil), Integer)

# Ring bell on input queue full.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:100
Net::SSH::Connection::Term::IMAXBEL = T.let(T.unsafe(nil), Integer)

# Map NL into CR on input.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:79
Net::SSH::Connection::Term::INCLR = T.let(T.unsafe(nil), Integer)

# Enable checking of parity errors.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:73
Net::SSH::Connection::Term::INPCK = T.let(T.unsafe(nil), Integer)

# Enable signals INTR, QUIT, [D]SUSP.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:103
Net::SSH::Connection::Term::ISIG = T.let(T.unsafe(nil), Integer)

# Strip 8th bit off characters.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:76
Net::SSH::Connection::Term::ISTRIP = T.let(T.unsafe(nil), Integer)

# Translate uppercase characters to lowercase.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:88
Net::SSH::Connection::Term::IUCLC = T.let(T.unsafe(nil), Integer)

# Any char will restart after stop.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:94
Net::SSH::Connection::Term::IXANY = T.let(T.unsafe(nil), Integer)

# Enable input flow control.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:97
Net::SSH::Connection::Term::IXOFF = T.let(T.unsafe(nil), Integer)

# Enable output flow control.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:91
Net::SSH::Connection::Term::IXON = T.let(T.unsafe(nil), Integer)

# Don't flush after interrupt.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:125
Net::SSH::Connection::Term::NOFLSH = T.let(T.unsafe(nil), Integer)

# Translate carriage return to newline (output).
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:152
Net::SSH::Connection::Term::OCRNL = T.let(T.unsafe(nil), Integer)

# Convert lowercase to uppercase.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:146
Net::SSH::Connection::Term::OLCUC = T.let(T.unsafe(nil), Integer)

# Map NL to CR-NL.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:149
Net::SSH::Connection::Term::ONLCR = T.let(T.unsafe(nil), Integer)

# Newline performs a carriage return (output).
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:158
Net::SSH::Connection::Term::ONLRET = T.let(T.unsafe(nil), Integer)

# Translate newline to carriage return-newline (output).
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:155
Net::SSH::Connection::Term::ONOCR = T.let(T.unsafe(nil), Integer)

# Enable output processing.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:143
Net::SSH::Connection::Term::OPOST = T.let(T.unsafe(nil), Integer)

# Parity enable.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:167
Net::SSH::Connection::Term::PARENB = T.let(T.unsafe(nil), Integer)

# Mark parity and framing errors.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:70
Net::SSH::Connection::Term::PARMRK = T.let(T.unsafe(nil), Integer)

# Odd parity, else even.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:170
Net::SSH::Connection::Term::PARODD = T.let(T.unsafe(nil), Integer)

# Retype pending input.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:140
Net::SSH::Connection::Term::PENDIN = T.let(T.unsafe(nil), Integer)

# Stop background jobs from output.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:128
Net::SSH::Connection::Term::TOSTOP = T.let(T.unsafe(nil), Integer)

# Specifies the input baud rate in bits per second.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:173
Net::SSH::Connection::Term::TTY_OP_ISPEED = T.let(T.unsafe(nil), Integer)

# Specifies the output baud rate in bits per second.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:176
Net::SSH::Connection::Term::TTY_OP_OSPEED = T.let(T.unsafe(nil), Integer)

# Toggles the flushing of terminal output.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:63
Net::SSH::Connection::Term::VDISCARD = T.let(T.unsafe(nil), Integer)

# Another suspend character.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:41
Net::SSH::Connection::Term::VDSUSP = T.let(T.unsafe(nil), Integer)

# End-of-file character (sends EOF from the terminal).
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:23
Net::SSH::Connection::Term::VEOF = T.let(T.unsafe(nil), Integer)

# End-of-line character in addition to carriage return and/or linefeed.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:26
Net::SSH::Connection::Term::VEOL = T.let(T.unsafe(nil), Integer)

# Additional end-of-line character.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:29
Net::SSH::Connection::Term::VEOL2 = T.let(T.unsafe(nil), Integer)

# Erase the character to left of the cursor.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:17
Net::SSH::Connection::Term::VERASE = T.let(T.unsafe(nil), Integer)

# Character to flush output.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:54
Net::SSH::Connection::Term::VFLUSH = T.let(T.unsafe(nil), Integer)

# Interrupt character; 255 if none. Similarly for the other characters.
# Not all of these characters are supported on all systems.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:11
Net::SSH::Connection::Term::VINTR = T.let(T.unsafe(nil), Integer)

# Kill the current input line.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:20
Net::SSH::Connection::Term::VKILL = T.let(T.unsafe(nil), Integer)

# Enter the next character typed literally, even if it is a special
# character.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:51
Net::SSH::Connection::Term::VLNEXT = T.let(T.unsafe(nil), Integer)

# The quit character (sends SIGQUIT signal on POSIX systems).
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:14
Net::SSH::Connection::Term::VQUIT = T.let(T.unsafe(nil), Integer)

# Reprints the current input line.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:44
Net::SSH::Connection::Term::VREPRINT = T.let(T.unsafe(nil), Integer)

# Continues paused output (normally control-Q).
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:32
Net::SSH::Connection::Term::VSTART = T.let(T.unsafe(nil), Integer)

# Prints system status line (load, command, pid, etc).
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:60
Net::SSH::Connection::Term::VSTATUS = T.let(T.unsafe(nil), Integer)

# Pauses output (normally control-S).
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:35
Net::SSH::Connection::Term::VSTOP = T.let(T.unsafe(nil), Integer)

# Suspends the current program.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:38
Net::SSH::Connection::Term::VSUSP = T.let(T.unsafe(nil), Integer)

# Switch to a different shell layer.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:57
Net::SSH::Connection::Term::VSWITCH = T.let(T.unsafe(nil), Integer)

# Erases a word left of cursor.
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:47
Net::SSH::Connection::Term::VWERASE = T.let(T.unsafe(nil), Integer)

# Enable input and output of uppercase characters by preceding their
# lowercase equivalents with "\".
#
# pkg:gem/net-ssh#lib/net/ssh/connection/term.rb:110
Net::SSH::Connection::Term::XCASE = T.let(T.unsafe(nil), Integer)

# This exception is raised when a connection attempt times out.
#
# pkg:gem/net-ssh#lib/net/ssh/errors.rb:12
class Net::SSH::ConnectionTimeout < ::Net::SSH::Exception; end

# This exception is raised when the remote host has disconnected
# unexpectedly.
#
# pkg:gem/net-ssh#lib/net/ssh/errors.rb:16
class Net::SSH::Disconnect < ::Net::SSH::Exception; end

# A general exception class, to act as the ancestor of all other Net::SSH
# exception classes.
#
# pkg:gem/net-ssh#lib/net/ssh/errors.rb:5
class Net::SSH::Exception < ::RuntimeError; end

# Fixes for two issues by Miklós Fazekas:
#
#   * if client closes a forwarded connection, but the server is
#     reading, net-ssh terminates with IOError socket closed.
#   * if client force closes (RST) a forwarded connection, but
#     server is reading, net-ssh terminates with [an exception]
#
# See:
#
#    http://net-ssh.lighthouseapp.com/projects/36253/tickets/7
#    http://github.com/net-ssh/net-ssh/tree/portfwfix
#
# pkg:gem/net-ssh#lib/net/ssh/buffered_io.rb:168
module Net::SSH::ForwardedBufferedIo
  # pkg:gem/net-ssh#lib/net/ssh/buffered_io.rb:174
  def fill(n = T.unsafe(nil)); end

  # Internal and experimental: registers a block called with the number of
  # bytes each #send_pending wrote to the socket.
  #
  # pkg:gem/net-ssh#lib/net/ssh/buffered_io.rb:192
  def on_sent(&block); end

  # pkg:gem/net-ssh#lib/net/ssh/buffered_io.rb:196
  def send_pending; end

  # Internal: shuts down the write side once pending output has been sent,
  # as OpenSSH does on CHANNEL_EOF (chan_rcvd_ieof, chan_obuf_empty).
  #
  # pkg:gem/net-ssh#lib/net/ssh/buffered_io.rb:222
  def shutdown_write_when_drained; end

  private

  # pkg:gem/net-ssh#lib/net/ssh/buffered_io.rb:229
  def shutdown_write_if_drained; end

  class << self
    # pkg:gem/net-ssh#lib/net/ssh/buffered_io.rb:169
    def extended(object); end
  end
end

# pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:8
module Net::SSH::HostKeyEntries; end

# @cert-authority entry
#
# pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:50
class Net::SSH::HostKeyEntries::CertAuthority
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:62
  def initialize(key, comment: T.unsafe(nil)); end

  # Returns true if every critical option in the certificate is one we can
  # enforce. net-ssh enforces none, so any critical option is unsupported
  # and, as OpenSSH does, must cause the certificate to be rejected.
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:102
  def critical_options_supported?(server_key); end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:67
  def matches_key?(server_key); end

  # Returns true if the certificate lists no principals (unrestricted) or
  # if the given hostname matches a listed principal. Host-certificate
  # principals are shell-glob patterns, matching OpenSSH, whose
  # sshkey_cert_check_host passes wildcard_pattern=1 so principals like
  # "*.example.com" are matched with match_pattern rather than strcmp.
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:80
  def matches_principal?(server_key, hostname); end

  # Returns true if the certificate is a host certificate. A user
  # certificate (type :user) must never authenticate a host.
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:95
  def matches_type?(server_key); end

  # Returns true if the certificate's validity window covers the current time.
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:86
  def matches_validity?(server_key); end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:51
  def ssh_types; end
end

# regular public key entry
#
# pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:10
class Net::SSH::HostKeyEntries::PubKey
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:14
  def initialize(key, comment: T.unsafe(nil)); end

  # The public key itself, e.g. an OpenSSL::PKey::PKey.
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:12
  def key; end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:31
  def matches_key?(server_key); end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:35
  def method_missing(name, *args, &block); end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:19
  def ssh_type; end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:23
  def ssh_types; end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:27
  def to_blob; end

  private

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:44
  def respond_to_missing?(_name, _include_private = T.unsafe(nil)); end
end

# Base class for host key exceptions. When rescuing this exception, you can
# inspect the key fingerprint and, if you want to proceed anyway, simply call
# the remember_host! method on the exception, and then retry.
#
# pkg:gem/net-ssh#lib/net/ssh/errors.rb:56
class Net::SSH::HostKeyError < ::Net::SSH::Exception
  # An accessor for getting at the data that was used to look up the host
  # (see also #fingerprint, #host, #port, #ip, and #key).
  #
  # pkg:gem/net-ssh#lib/net/ssh/errors.rb:65
  def [](key); end

  # the callback to use when #remember_host! is called
  #
  # pkg:gem/net-ssh#lib/net/ssh/errors.rb:58
  def callback=(_arg0); end

  # situation-specific data describing the host (see #host, #port, etc.)
  #
  # pkg:gem/net-ssh#lib/net/ssh/errors.rb:61
  def data=(_arg0); end

  # Returns the fingerprint of the key for the host, which either was not
  # found or did not match.
  #
  # pkg:gem/net-ssh#lib/net/ssh/errors.rb:71
  def fingerprint; end

  # Returns the host name that was connected to.
  #
  # pkg:gem/net-ssh#lib/net/ssh/errors.rb:76
  def host; end

  # Returns the IP address of the remote host, as reported by the socket,
  # or nil when connected through a ProxyCommand.
  #
  # pkg:gem/net-ssh#lib/net/ssh/errors.rb:87
  def ip; end

  # Returns the key itself, as reported by the remote host.
  #
  # pkg:gem/net-ssh#lib/net/ssh/errors.rb:93
  def key; end

  # Returns the port number that was connected to.
  #
  # pkg:gem/net-ssh#lib/net/ssh/errors.rb:81
  def port; end

  # Tell Net::SSH to record this host and key in the known hosts file, so
  # that subsequent connections will remember them.
  #
  # pkg:gem/net-ssh#lib/net/ssh/errors.rb:99
  def remember_host!; end

  private

  # pkg:gem/net-ssh#lib/net/ssh/errors.rb:105
  def session; end
end

# Raised when the cached key for a particular host does not match the
# key given by the host, which can be indicative of a man-in-the-middle
# attack. When rescuing this exception, you can inspect the key fingerprint
# and, if you want to proceed anyway, simply call the remember_host!
# method on the exception, and then retry.
#
# pkg:gem/net-ssh#lib/net/ssh/errors.rb:115
class Net::SSH::HostKeyMismatch < ::Net::SSH::HostKeyError; end

# Raised when there is no cached key for a particular host, which probably
# means that the host has simply not been seen before.
# When rescuing this exception, you can inspect the key fingerprint and, if
# you want to proceed anyway, simply call the remember_host! method on the
# exception, and then retry.
#
# pkg:gem/net-ssh#lib/net/ssh/errors.rb:122
class Net::SSH::HostKeyUnknown < ::Net::SSH::HostKeyError; end

# Represents the result of a search in known hosts
# see search_for
#
# pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:110
class Net::SSH::HostKeys
  include ::Enumerable

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:114
  def initialize(host_keys, host, known_hosts, options = T.unsafe(nil)); end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:121
  def add_host_key(key); end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:126
  def each(&block); end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:130
  def empty?; end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:112
  def host; end

  # Returns the bare hostname, stripping port and IP portions from the
  # comma-separated host string used internally.
  #
  # Examples:
  #   "server.example.com"            => "server.example.com"
  #   "server.example.com,1.2.3.4"    => "server.example.com"
  #   "[server.example.com]:2222"      => "server.example.com"
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:141
  def hostname; end
end

# A factory class for returning new Key classes. It is used for obtaining
# OpenSSL key instances via their SSH names, and for loading both public and
# private keys. It used used primarily by Net::SSH itself, internally, and
# will rarely (if ever) be directly used by consumers of the library.
#
#   klass = Net::SSH::KeyFactory.get("rsa")
#   assert klass.is_a?(OpenSSL::PKey::RSA)
#
#   key = Net::SSH::KeyFactory.load_public_key("~/.ssh/id_dsa.pub")
#
# pkg:gem/net-ssh#lib/net/ssh/key_factory.rb:18
class Net::SSH::KeyFactory
  class << self
    # Fetch an OpenSSL key instance by its SSH name. It will be a new,
    # empty key of the given type.
    #
    # pkg:gem/net-ssh#lib/net/ssh/key_factory.rb:31
    def get(name); end

    # Loads a private key. It will correctly determine
    # whether the file describes an RSA or DSA key, and will load it
    # appropriately. The new key is returned. If the key itself is
    # encrypted (requiring a passphrase to use), the user will be
    # prompted to enter their password unless passphrase works.
    #
    # pkg:gem/net-ssh#lib/net/ssh/key_factory.rb:50
    def load_data_private_key(data, passphrase = T.unsafe(nil), ask_passphrase = T.unsafe(nil), filename = T.unsafe(nil), prompt = T.unsafe(nil)); end

    # Loads a public key. It will correctly determine whether
    # the file describes an RSA or DSA key, and will load it
    # appropriately. The new public key is returned.
    #
    # pkg:gem/net-ssh#lib/net/ssh/key_factory.rb:90
    def load_data_public_key(data, filename = T.unsafe(nil)); end

    # Loads a private key from a file. It will correctly determine
    # whether the file describes an RSA or DSA key, and will load it
    # appropriately. The new key is returned. If the key itself is
    # encrypted (requiring a passphrase to use), the user will be
    # prompted to enter their password unless passphrase works.
    #
    # pkg:gem/net-ssh#lib/net/ssh/key_factory.rb:40
    def load_private_key(filename, passphrase = T.unsafe(nil), ask_passphrase = T.unsafe(nil), prompt = T.unsafe(nil)); end

    # Loads a public key from a file. It will correctly determine whether
    # the file describes an RSA or DSA key, and will load it
    # appropriately. The new public key is returned.
    #
    # pkg:gem/net-ssh#lib/net/ssh/key_factory.rb:82
    def load_public_key(filename); end

    private

    # Determine whether the file describes an RSA or DSA key, and return how load it
    # appropriately.
    #
    # pkg:gem/net-ssh#lib/net/ssh/key_factory.rb:204
    def classify_key(data, filename); end

    # pkg:gem/net-ssh#lib/net/ssh/key_factory.rb:108
    def public_key_type?(type); end
  end
end

# Specifies the mapping of SSH names to OpenSSL key classes.
#
# pkg:gem/net-ssh#lib/net/ssh/key_factory.rb:20
Net::SSH::KeyFactory::MAP = T.let(T.unsafe(nil), Hash)

# Searches an OpenSSH-style known-host file for a given host, and returns all
# matching keys. This is used to implement host-key verification, as well as
# to determine what key a user prefers to use for a given host.
#
# This is used internally by Net::SSH, and will never need to be used directly
# by consumers of the library.
#
# pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:152
class Net::SSH::KnownHosts
  # Instantiate a new KnownHosts instance that will search the given known-hosts
  # file. The path is expanded file File.expand_path.
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:213
  def initialize(source); end

  # Tries to append an entry to the current source file for the given host
  # and key. If it is unable to (because the file is not writable, for
  # instance), an exception will be raised.
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:310
  def add(host, key); end

  # Returns an array of all keys that are known to be associatd with the
  # given host. The +host+ parameter is either the domain name or ip address
  # of the host, or both (comma-separated). Additionally, if a non-standard
  # port is being used, it may be specified by putting the host (or ip, or
  # both) in square brackets, and appending the port outside the brackets
  # after a colon. Possible formats for +host+, then, are;
  #
  #   "net.ssh.test"
  #   "1.2.3.4"
  #   "net.ssh.test,1.2.3.4"
  #   "[net.ssh.test]:5555"
  #   "[1,2,3,4]:5555"
  #   "[net.ssh.test]:5555,[1.2.3.4]:5555
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:232
  def keys_for(host, options = T.unsafe(nil)); end

  # Indicates whether one of the entries matches an hostname that has been
  # stored as a HMAC-SHA1 hash in the known hosts.
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:294
  def known_host_hash?(hostlist, entries); end

  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:277
  def match(host, pattern); end

  # The host-key file name that this KnownHosts instance will use to search
  # for keys.
  #
  # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:209
  def source; end

  class << self
    # Looks in all user known host files (see KnownHosts.hostfiles) and tries to
    # add an entry for the given host and key to the first file it is able
    # to.
    #
    # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:197
    def add(host, key, options = T.unsafe(nil)); end

    # Looks in the given +options+ hash for the :user_known_hosts_file and
    # :global_known_hosts_file keys, and returns an array of all known
    # hosts files. If the :user_known_hosts_file key is not set, the
    # default is returned (~/.ssh/known_hosts and ~/.ssh/known_hosts2). If
    # :global_known_hosts_file is not set, the default is used
    # (/etc/ssh/ssh_known_hosts and /etc/ssh/ssh_known_hosts2).
    #
    # If you only want the user known host files, you can pass :user as
    # the second option.
    #
    # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:182
    def hostfiles(options, which = T.unsafe(nil)); end

    # Searches all known host files (see KnownHosts.hostfiles) for all keys
    # of the given host. Returns an enumerable of keys found.
    #
    # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:163
    def search_for(host, options = T.unsafe(nil)); end

    # Search for all known keys for the given host, in every file given in
    # the +files+ array. Returns the list of keys.
    #
    # pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:169
    def search_in(files, host, options = T.unsafe(nil)); end
  end
end

# pkg:gem/net-ssh#lib/net/ssh/known_hosts.rb:153
Net::SSH::KnownHosts::SUPPORTED_TYPE = T.let(T.unsafe(nil), Array)

# A simple module to make logging easier to deal with. It assumes that the
# logger instance (if not nil) quacks like a Logger object (in Ruby's
# standard library). Although used primarily internally by Net::SSH, it
# can easily be used to add Net::SSH-like logging to your own programs.
#
#   class MyClass
#     include Net::SSH::Loggable
#   end
#
#   Net::SSH.start(...) do |ssh|
#     obj = MyClass.new
#     obj.logger = ssh.logger
#     ...
#   end
#
# pkg:gem/net-ssh#lib/net/ssh/loggable.rb:17
module Net::SSH::Loggable
  # Displays the result of yielding if the log level is Logger::DEBUG or
  # greater.
  #
  # pkg:gem/net-ssh#lib/net/ssh/loggable.rb:24
  def debug; end

  # Displays the result of yielding if the log level is Logger:ERROR or
  # greater.
  #
  # pkg:gem/net-ssh#lib/net/ssh/loggable.rb:42
  def error; end

  # Displays the result of yielding if the log level is Logger::FATAL or
  # greater.
  #
  # pkg:gem/net-ssh#lib/net/ssh/loggable.rb:48
  def fatal; end

  # Displays the result of yielding if the log level is Logger::INFO or
  # greater.
  #
  # pkg:gem/net-ssh#lib/net/ssh/loggable.rb:30
  def info; end

  # The logger instance that will be used to log messages. If nil, nothing
  # will be logged.
  #
  # pkg:gem/net-ssh#lib/net/ssh/loggable.rb:20
  def logger; end

  # The logger instance that will be used to log messages. If nil, nothing
  # will be logged.
  #
  # pkg:gem/net-ssh#lib/net/ssh/loggable.rb:20
  def logger=(_arg0); end

  # Displays the result of yielding if the log level is Logger::WARN or
  # greater. (Called lwarn to avoid shadowing with Kernel#warn.)
  #
  # pkg:gem/net-ssh#lib/net/ssh/loggable.rb:36
  def lwarn; end

  private

  # Sets the "facility" value, used for reporting where a log message
  # originates. It defaults to the name of class with the object_id
  # appended.
  #
  # pkg:gem/net-ssh#lib/net/ssh/loggable.rb:57
  def facility; end
end

# Reuse of an existing OpenSSH ControlMaster connection, enabled by the
# :control_master option of Net::SSH.start. Net::SSH only ever connects to
# a master someone else started (e.g. with ssh -M or ControlMaster auto);
# it never becomes one.
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:10
module Net::SSH::Multiplex
  class << self
    # Returns a Connection::Session running through the ControlMaster for
    # this connection, or nil (after logging why) when there is no usable
    # master, in which case the caller connects as usual. +explicit+ are
    # the option names the caller passed to Net::SSH.start. Raises
    # ArgumentError for an invalid ControlPath, as ssh does.
    #
    # pkg:gem/net-ssh#lib/net/ssh/multiplex.rb:45
    def connect(host_arg, host, user, options, explicit: T.unsafe(nil)); end

    # pkg:gem/net-ssh#lib/net/ssh/multiplex.rb:34
    def validate_options!(options); end

    private

    # pkg:gem/net-ssh#lib/net/ssh/multiplex.rb:101
    def jump_host(proxy); end

    # pkg:gem/net-ssh#lib/net/ssh/multiplex.rb:107
    def log_master_owned(logger, explicit); end

    # ENOENT and ECONNREFUSED just mean no master is running, while the
    # other errors mean a socket is there but can't be used.
    #
    # pkg:gem/net-ssh#lib/net/ssh/multiplex.rb:66
    def open_proxy(path, options); end

    # Keepalive is a global request, which the master doesn't allow; it
    # watches its own connection anyway. The master serves agent requests
    # from its own agent only if it has ForwardAgent enabled itself.
    #
    # pkg:gem/net-ssh#lib/net/ssh/multiplex.rb:117
    def session_options(logger, options); end

    # pkg:gem/net-ssh#lib/net/ssh/multiplex.rb:76
    def socket_path(host_arg, host, user, options); end
  end
end

# Connects to an OpenSSH ControlMaster's UNIX socket and switches it to
# proxy mode (MUX_C_PROXY, OpenSSH 7.4 and later), after which the socket
# carries plain SSH connection-protocol packets. See PROTOCOL.mux and
# mux.c in OpenSSH.
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:19
class Net::SSH::Multiplex::Client
  include ::Net::SSH::Loggable

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:36
  def initialize(path, timeout:, logger: T.unsafe(nil)); end

  # Performs the HELLO and PROXY exchange and returns the connected
  # socket, positioned at the first proxied packet. Raises
  # Multiplex::Error, SystemCallError or IOError if the master can't be
  # used; the socket is closed in that case.
  #
  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:46
  def connect_proxy; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:34
  def path; end

  private

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:89
  def hello; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:60
  def open_socket; end

  # Reads exactly +count+ bytes so nothing after the PROXY reply, which
  # already belongs to the packet stream, is consumed here.
  #
  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:141
  def read_exactly(count); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:131
  def read_message; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:102
  def request_proxy; end

  # The master itself rejects clients with a different uid (channels.c,
  # getpeereid); checking here also keeps us off a socket someone else
  # planted at the ControlPath.
  #
  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:80
  def verify_peer; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:154
  def wait_for(direction, socket); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:118
  def write_message(type, *args); end
end

# Mux control messages are small; this only guards against reading a
# bogus length from something that isn't a ControlMaster.
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:32
Net::SSH::Multiplex::Client::MAX_MESSAGE_SIZE = T.let(T.unsafe(nil), Integer)

# pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:23
Net::SSH::Multiplex::Client::MUX_C_PROXY = T.let(T.unsafe(nil), Integer)

# pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:22
Net::SSH::Multiplex::Client::MUX_MSG_HELLO = T.let(T.unsafe(nil), Integer)

# pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:25
Net::SSH::Multiplex::Client::MUX_S_FAILURE = T.let(T.unsafe(nil), Integer)

# pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:24
Net::SSH::Multiplex::Client::MUX_S_PERMISSION_DENIED = T.let(T.unsafe(nil), Integer)

# pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:26
Net::SSH::Multiplex::Client::MUX_S_PROXY = T.let(T.unsafe(nil), Integer)

# pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:28
Net::SSH::Multiplex::Client::PROTOCOL_VERSION = T.let(T.unsafe(nil), Integer)

# Expands a ControlPath the way OpenSSH's ssh does: a leading ~ first,
# then ${ENV} and the % tokens below in a single pass (ssh.c,
# DEFAULT_CLIENT_PERCENT_EXPAND_ARGS in sshconnect.h, misc.c
# percent_dollar_expand).
#
#   %%  a literal %
#   %C  SHA1 hex of %l%h%p%r%j
#   %d  local home directory
#   %h  remote host name, after HostName
#   %i  local uid
#   %j  host of the last ProxyJump hop, or empty
#   %k  the host key alias, or the host name as given
#   %L  local host name up to the first dot
#   %l  local host name
#   %n  the host name as given
#   %p  remote port
#   %r  remote user
#   %u  local user
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex/control_path.rb:27
class Net::SSH::Multiplex::ControlPath
  # +host_arg+ is the host as given, +host+ the one connected to after
  # HostName.
  #
  # pkg:gem/net-ssh#lib/net/ssh/multiplex/control_path.rb:30
  def initialize(host_arg:, host:, port:, remote_user:, jump_host: T.unsafe(nil), host_key_alias: T.unsafe(nil)); end

  # Raises ArgumentError for an unknown % token, an unset ${ENV}
  # variable or an unknown ~user, which make ssh refuse the ControlPath
  # too.
  #
  # pkg:gem/net-ssh#lib/net/ssh/multiplex/control_path.rb:43
  def expand(path); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/control_path.rb:47
  def tokens; end

  private

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/control_path.rb:111
  def address?(host); end

  # ssh uses the home directory from the password database, not $HOME
  # (misc.c, tilde_expand).
  #
  # pkg:gem/net-ssh#lib/net/ssh/multiplex/control_path.rb:84
  def expand_tilde(path); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/control_path.rb:93
  def expand_tokens(path); end

  class << self
    # The host ssh uses for %j: the last hop of a ProxyJump list, without
    # user or port (readconf.c, parse_jump).
    #
    # pkg:gem/net-ssh#lib/net/ssh/multiplex/control_path.rb:70
    def jump_host(proxy_jump); end
  end
end

# Used for the mux handshake when the :timeout option isn't set.
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex.rb:17
Net::SSH::Multiplex::DEFAULT_TIMEOUT = T.let(T.unsafe(nil), Integer)

# Raised when the ControlMaster socket can't be used, e.g. the master
# refused the request or spoke an unexpected protocol.
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex/client.rb:13
class Net::SSH::Multiplex::Error < ::Net::SSH::Exception; end

# Options for setting up a connection, which the master already did
# with its own settings.
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex.rb:21
Net::SSH::Multiplex::MASTER_OWNED_OPTIONS = T.let(T.unsafe(nil), Array)

# Packet framing on a ControlMaster socket in proxy mode: the usual
# uint32 packet_length and byte padding_length, but no padding, MAC,
# encryption or compression. The master parses everything after the
# padding_length byte as payload (channel_proxy_downstream in OpenSSH's
# channels.c), so padding must not be sent.
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:18
module Net::SSH::Multiplex::PacketSocket
  include ::Net::SSH::Loggable
  include ::Net::SSH::BufferedIo

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:28
  def available_for_read?; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:59
  def enqueue_packet(payload); end

  # Same contract as Net::SSH::Transport::PacketStream#next_packet.
  #
  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:33
  def next_packet(mode = T.unsafe(nil), timeout = T.unsafe(nil)); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:64
  def send_packet(payload); end

  private

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:71
  def poll_next_packet; end

  class << self
    # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:24
    def extended(object); end
  end
end

# OpenSSH's PACKET_MAX_SIZE.
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:22
Net::SSH::Multiplex::PacketSocket::MAX_PACKET_SIZE = T.let(T.unsafe(nil), Integer)

# Stands in for Net::SSH::Transport::Session underneath a
# Net::SSH::Connection::Session when connected through an OpenSSH
# ControlMaster in proxy mode. Key exchange, rekeying, host key
# verification and authentication all belong to the master, so the
# matching transport methods are no-ops or raise
# NotSupportedOverControlMaster.
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:98
class Net::SSH::Multiplex::ProxyTransport
  include ::Net::SSH::Loggable
  include ::Net::SSH::Connection::Constants

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:115
  def initialize(socket, host:, control_path:, options: T.unsafe(nil)); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:174
  def algorithms; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:138
  def close; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:134
  def closed?; end

  # The ControlMaster socket path this transport is connected through.
  #
  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:113
  def control_path; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:159
  def enqueue_message(message); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:168
  def hint(*); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:110
  def host; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:126
  def host_as_string; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:182
  def host_key_verifier; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:178
  def host_keys; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:147
  def next_message; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:110
  def options; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:130
  def peer; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:151
  def poll_message(mode = T.unsafe(nil), *); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:110
  def port; end

  # The master rekeys its own connection.
  #
  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:164
  def rekey!; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:166
  def rekey_as_needed; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:155
  def send_message(message); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:170
  def server_version; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:142
  def shutdown!; end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:110
  def socket; end

  private

  # The master kills the proxy connection on any global request other
  # than tcpip-forward, and consumes the reply to that one itself, so
  # its success or failure and an allocated port 0 can't be observed
  # (channels.c channel_proxy_downstream, clientloop.c
  # client_global_request_reply).
  #
  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:197
  def check_supported(data); end

  # pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:188
  def not_supported(what); end
end

# pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:102
Net::SSH::Multiplex::ProxyTransport::DEFAULT_PORT = T.let(T.unsafe(nil), Integer)

# Channel requests whose follow-up channel the server opens towards
# the master, which serves it from its own agent or X display only if
# it has ForwardAgent or ForwardX11 enabled itself, and rejects it
# otherwise (clientloop.c, client_input_channel_open).
#
# pkg:gem/net-ssh#lib/net/ssh/multiplex/proxy_transport.rb:108
Net::SSH::Multiplex::ProxyTransport::UNSUPPORTED_CHANNEL_REQUESTS = T.let(T.unsafe(nil), Array)

# pkg:gem/net-ssh#lib/net/ssh/multiplex.rb:32
Net::SSH::Multiplex::VALUES = T.let(T.unsafe(nil), Array)

# pkg:gem/net-ssh#lib/net/ssh.rb:392
Net::SSH::NIL_ALLOWED_OPTIONS = T.let(T.unsafe(nil), Array)

# pkg:gem/net-ssh#lib/net/ssh.rb:394
Net::SSH::NIL_OPTION_HINTS = T.let(T.unsafe(nil), Hash)

# Raised when a session connected through an OpenSSH ControlMaster (see the
# :control_master option of Net::SSH.start) is asked for something the
# master's proxy mode cannot carry, such as remote port forwarding, agent
# or X11 forwarding, or other global requests.
#
# pkg:gem/net-ssh#lib/net/ssh/errors.rb:30
class Net::SSH::NotSupportedOverControlMaster < ::Net::SSH::Exception; end

# A specialization of Buffer that knows the format of certain common
# packet types. It auto-parses those packet types, and allows them to
# be accessed via the #[] accessor.
#
#   data = some_channel_request_packet
#   packet = Net::SSH::Packet.new(data)
#
#   p packet.type #-> 98 (CHANNEL_REQUEST)
#   p packet[:request]
#   p packet[:want_reply]
#
# This is used exclusively internally by Net::SSH, and unless you're doing
# protocol-level manipulation or are extending Net::SSH in some way, you'll
# never need to use this class directly.
#
# pkg:gem/net-ssh#lib/net/ssh/packet.rb:22
class Net::SSH::Packet < ::Net::SSH::Buffer
  include ::Net::SSH::Connection::Constants
  include ::Net::SSH::Authentication::Constants
  include ::Net::SSH::Transport::Constants

  # Create a new packet from the given payload. This will automatically
  # parse the packet if it is one that has been previously registered with
  # Packet.register; otherwise, the packet will need to be manually parsed
  # using the methods provided in the Net::SSH::Buffer superclass.
  #
  # pkg:gem/net-ssh#lib/net/ssh/packet.rb:75
  def initialize(payload); end

  # Access one of the auto-parsed fields by name. Raises an error if no
  # element by the given name exists.
  #
  # pkg:gem/net-ssh#lib/net/ssh/packet.rb:84
  def [](name); end

  # The (integer) type of this packet.
  #
  # pkg:gem/net-ssh#lib/net/ssh/packet.rb:69
  def type; end

  private

  # Parse the packet's contents and assign the named elements, as described
  # by the registered format for the packet.
  #
  # pkg:gem/net-ssh#lib/net/ssh/packet.rb:95
  def instantiate!; end

  class << self
    # Register a new packet type that should be recognized and auto-parsed by
    # Net::SSH::Packet. Note that any packet type that is not preregistered
    # will not be autoparsed.
    #
    # The +pairs+ parameter must be either empty, or an array of two-element
    # tuples, where the first element of each tuple is the name of the field,
    # and the second is the type.
    #
    #   register DISCONNECT, [:reason_code, :long], [:description, :string], [:language, :string]
    #
    # pkg:gem/net-ssh#lib/net/ssh/packet.rb:34
    def register(type, *pairs); end
  end
end

# Default prompt implementation, called for asking password from user.
# It will never be instantiated directly, but will instead be created for
# you automatically.
#
# A custom prompt objects can implement caching, or different UI. The prompt
# object should implemnted a start method, which should return something implementing
# ask and success. Net::SSH uses it like:
#
#   prompter = options[:password_prompt].start({type:'password'})
#   while !ok && max_retries < 3
#     user = prompter.ask("user: ", true)
#     password = prompter.ask("password: ", false)
#     ok = send(user, password)
#     prompter.sucess if ok
#   end
#
# pkg:gem/net-ssh#lib/net/ssh/prompt.rb:21
class Net::SSH::Prompt
  # pkg:gem/net-ssh#lib/net/ssh/prompt.rb:27
  def initialize(options = T.unsafe(nil)); end

  # start password session. Multiple questions might be asked multiple times
  # on the returned object. Info hash tries to uniquely identify the password
  # session, so caching implementations can save passwords properly.
  #
  # pkg:gem/net-ssh#lib/net/ssh/prompt.rb:57
  def start(info); end

  class << self
    # factory
    #
    # pkg:gem/net-ssh#lib/net/ssh/prompt.rb:23
    def default(options = T.unsafe(nil)); end
  end
end

# default prompt object implementation. More sophisticated implemenetations
# might implement caching.
#
# pkg:gem/net-ssh#lib/net/ssh/prompt.rb:31
class Net::SSH::Prompt::Prompter
  # pkg:gem/net-ssh#lib/net/ssh/prompt.rb:32
  def initialize(info); end

  # ask input from user, a prompter might ask for multiple inputs
  # (like user and password) in a single session.
  #
  # pkg:gem/net-ssh#lib/net/ssh/prompt.rb:41
  def ask(prompt, echo = T.unsafe(nil)); end

  # success method will be called when the password was accepted
  # It's a good time to save password asked to a cache.
  #
  # pkg:gem/net-ssh#lib/net/ssh/prompt.rb:51
  def success; end
end

# pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:5
module Net::SSH::Service; end

# This class implements various port forwarding services for use by
# Net::SSH clients. The Forward class should never need to be instantiated
# directly; instead, it should be accessed via the singleton instance
# returned by Connection::Session#forward:
#
#   ssh.forward.local(1234, "www.capify.org", 80)
#
# pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:12
class Net::SSH::Service::Forward
  include ::Net::SSH::Loggable

  # Instantiates a new Forward service instance atop the given connection
  # service session. This will register new channel open handlers to handle
  # the specialized channels that the SSH port forwarding protocols employ.
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:25
  def initialize(session); end

  # Returns a list of all active locally forwarded sockets. The returned value
  # is an array of Unix domain socket file paths.
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:170
  def active_local_sockets; end

  # Returns a list of all active locally forwarded ports. The returned value
  # is an array of arrays, where each element is a two-element tuple
  # consisting of the local port and bind address corresponding to the
  # forwarding port.
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:119
  def active_locals; end

  # Returns all active remote forwarded ports and where they forward to. The
  # returned value is a hash from [<forwarding port on the local host>, <local forwarding address>]
  # to [<port on the remote host>, <remote bind address>].
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:271
  def active_remote_destinations; end

  # Returns all active forwarded remote ports. The returned value is an
  # array of two-element tuples, where the first element is the port on the
  # remote host and the second is the bind address.
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:264
  def active_remotes; end

  # Enables SSH agent forwarding on the given channel. The forwarded agent
  # will remain active even after the channel closes--the channel is only
  # used as the transport for enabling the forwarded connection. You should
  # never need to call this directly--it is called automatically the first
  # time a session channel is opened, when the connection was created with
  # :forward_agent set to true:
  #
  #    Net::SSH.start("remote.host", "me", :forward_agent => true) do |ssh|
  #      ssh.open_channel do |ch|
  #        # agent will be automatically forwarded by this point
  #      end
  #      ssh.loop
  #    end
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:290
  def agent(channel); end

  # Terminates an active local forwarded port.
  #
  #   ssh.forward.cancel_local(1234)
  #   ssh.forward.cancel_local(1234, "0.0.0.0")
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:108
  def cancel_local(port, bind_address = T.unsafe(nil)); end

  # Terminates an active local forwarded socket.
  #
  #   ssh.forward.cancel_local_socket('/tmp/foo.sock')
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:161
  def cancel_local_socket(local_socket_path); end

  # Requests that a remote forwarded port be cancelled. The remote forwarded
  # port on the remote host, bound to the given address on the remote host,
  # will be terminated, but not immediately. This method returns immediately
  # after queueing the request to be sent to the server. If for some reason
  # the port cannot be cancelled, an exception will be raised (asynchronously).
  #
  # If you want to know when the connection has been cancelled, it will no
  # longer be present in the #active_remotes list. If you want to block until
  # the port is no longer active, you could do something like this:
  #
  #   ssh.forward.cancel_remote(1234, "0.0.0.0")
  #   ssh.loop { ssh.forward.active_remotes.include?([1234, "0.0.0.0"]) }
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:251
  def cancel_remote(port, host = T.unsafe(nil)); end

  # Starts listening for connections on the local host, and forwards them
  # to the specified remote host/port via the SSH connection. This method
  # accepts either three or four arguments. When four arguments are given,
  # they are:
  #
  # * the local address to bind to
  # * the local port to listen on
  # * the remote host to forward connections to
  # * the port on the remote host to connect to
  #
  # If three arguments are given, it is as if the local bind address is
  # "127.0.0.1", and the rest are applied as above.
  #
  # To request an ephemeral port on the local server, provide 0 (zero) for
  # the local port number. In all cases, this method will return the port
  # that has been assigned.
  #
  #   ssh.forward.local(1234, "www.capify.org", 80)
  #   assigned_port = ssh.forward.local("0.0.0.0", 0, "www.capify.org", 80)
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:57
  def local(*args); end

  # Starts listening for connections on the local host, and forwards them
  # to the specified remote socket via the SSH connection. This will
  # (re)create the local socket file. The remote server needs to have the
  # socket file already available.
  #
  #   ssh.forward.local_socket('/tmp/local.sock', '/tmp/remote.sock')
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:129
  def local_socket(local_socket_path, remote_socket_path); end

  # Requests that all connections on the given remote-port be forwarded via
  # the local host to the given port/host. The last argument describes the
  # bind address on the remote host, and defaults to 127.0.0.1.
  #
  # This method will return immediately, but the port will not actually be
  # forwarded immediately. If the remote server is not able to begin the
  # listener for this request, an exception will be raised asynchronously.
  #
  # To request an ephemeral port on the remote server, provide 0 (zero) for
  # the port number. The assigned port will show up in the # #active_remotes
  # list.
  #
  # remote_host is interpreted by the server per RFC 4254, which has these
  # special values:
  #
  # - "" means that connections are to be accepted on all protocol
  #   families supported by the SSH implementation.
  # - "0.0.0.0" means to listen on all IPv4 addresses.
  # - "::" means to listen on all IPv6 addresses.
  # - "localhost" means to listen on all protocol families supported by
  #   the SSH implementation on loopback addresses only ([RFC3330] and
  #   [RFC3513]).
  # - "127.0.0.1" and "::1" indicate listening on the loopback
  #   interfaces for IPv4 and IPv6, respectively.
  #
  # You may pass a block that will be called when the the port forward
  # request receives a response.  This block will be passed the remote_port
  # that was actually bound to, or nil if the binding failed.  If the block
  # returns :no_exception, the "failed binding" exception will not be thrown.
  #
  # If you want to block until the port is active, you could do something
  # like this:
  #
  #   got_remote_port = nil
  #   remote(port, host, remote_port, remote_host) do |actual_remote_port|
  #     got_remote_port = actual_remote_port || :error
  #     :no_exception # will yield the exception on my own thread
  #   end
  #   session.loop { !got_remote_port }
  #   if got_remote_port == :error
  #     raise Net::SSH::Exception, "remote forwarding request failed"
  #   end
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:217
  def remote(port, host, remote_port, remote_host = T.unsafe(nil)); end

  # an alias, for token backwards compatibility with the 1.x API
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:237
  def remote_to(port, host, remote_port, remote_host = T.unsafe(nil)); end

  # The underlying connection service instance that the port-forwarding
  # services employ.
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:17
  def session; end

  private

  # The callback used when an auth-agent channel is requested by the server.
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:418
  def auth_agent_channel(session, channel, packet); end

  # The callback used when a new "forwarded-tcpip" channel is requested
  # by the server.  This will open a new socket to the host/port specified
  # when the forwarded connection was first requested.
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:396
  def forwarded_tcpip(session, channel, packet); end

  # Perform setup operations that are common to all forwarded channels.
  # +client+ is a socket, +channel+ is the channel that was just created,
  # and +type+ is an arbitrary string describing the type of the channel.
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:315
  def prepare_client(client, channel, type); end

  # not a real socket, so use a simpler behaviour
  #
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:374
  def prepare_simple_client(client, channel, type); end
end

# A simple class for representing a requested remote forwarded port.
#
# pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:20
class Net::SSH::Service::Forward::Remote < ::Struct
  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:20
  def host; end

  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:20
  def host=(_); end

  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:20
  def port; end

  # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:20
  def port=(_); end

  class << self
    # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:20
    def [](*_arg0); end

    # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:20
    def inspect; end

    # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:20
    def keyword_init?; end

    # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:20
    def members; end

    # pkg:gem/net-ssh#lib/net/ssh/service/forward.rb:20
    def new(*_arg0); end
  end
end

# This exception is raised when the remote host has disconnected/
# timeouted unexpectedly.
#
# pkg:gem/net-ssh#lib/net/ssh/errors.rb:20
class Net::SSH::Timeout < ::Net::SSH::Disconnect; end

# pkg:gem/net-ssh#lib/net/ssh/transport/ctr.rb:4
module Net::SSH::Transport; end

# Implements the aes128-gcm@openssh cipher
#
# pkg:gem/net-ssh#lib/net/ssh/transport/aes128_gcm.rb:6
class Net::SSH::Transport::AES128_GCM
  include ::Net::SSH::Loggable
  extend ::Net::SSH::Transport::GCMCipher

  # pkg:gem/net-ssh#lib/net/ssh/transport/aes128_gcm.rb:7
  def initialize(encrypt:, key:); end

  # pkg:gem/net-ssh#lib/net/ssh/transport/aes128_gcm.rb:24
  def algo_name; end

  # pkg:gem/net-ssh#lib/net/ssh/transport/aes128_gcm.rb:7
  def apply_nonce; end

  # pkg:gem/net-ssh#lib/net/ssh/transport/aes128_gcm.rb:7
  def block_size; end

