  def on_path?(path); end

  # pkg:gem/omniauth#lib/omniauth/strategy/paths.rb:13
  def on_request_path?; end

  # pkg:gem/omniauth#lib/omniauth/strategy/paths.rb:29
  def path_prefix; end

