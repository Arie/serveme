# No-op implementation of a meter provider.
#
# pkg:gem/opentelemetry-metrics-api#lib/opentelemetry/metrics/meter_provider.rb:10
class OpenTelemetry::Metrics::MeterProvider
  # Returns a {Meter} instance.
  #
  # @param [String] name Instrumentation scope name
  # @param [optional String] version Instrumentation scope version
  # @param [optional Hash{String => String, Numeric, Boolean, Array<String, Numeric, Boolean>}] attributes
  #   Instrumentation scope attributes
  #
  # @return [Meter]
  #
  # pkg:gem/opentelemetry-metrics-api#lib/opentelemetry/metrics/meter_provider.rb:19
  def meter(name, version: T.unsafe(nil), attributes: T.unsafe(nil)); end
end

