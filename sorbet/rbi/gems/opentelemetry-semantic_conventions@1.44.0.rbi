# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:81
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_DISK_MERGED = T.let(T.unsafe(nil), String)

# Disk operations count.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:96
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_DISK_OPERATIONS = T.let(T.unsafe(nil), String)

# Sum of the time each operation took to complete.
#
# Because it is the sum of time each request took, parallel-issued requests each contribute to make the count grow. Measured as:
