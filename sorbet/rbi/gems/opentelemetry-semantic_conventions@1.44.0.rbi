OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_PROCESS_COUNT = T.let(T.unsafe(nil), String)

# Total number of processes created over uptime of the host.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:309
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_PROCESS_CREATED = T.let(T.unsafe(nil), String)

# The maximum number of concurrent processes/tasks allowed by the operating system.
#
# On Linux, this corresponds to `/proc/sys/kernel/pid_max` or `/proc/sys/kernel/threads-max`.
# A per-user process limit may also be retrieved via `getrlimit(RLIMIT_NPROC)`.
# On BSD-like systems, this corresponds to `sysctl kern.maxproc`. This metric is unsupported on Windows systems.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:318
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_PROCESS_LIMIT = T.let(T.unsafe(nil), String)

# Deprecated, use `process.state` instead.
#
# @note Stability Level: development
# @deprecated Replaced by `process.state`.
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/attributes.rb:110
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_PROCESS_STATUS = T.let(T.unsafe(nil), String)

# The time the system has been running.
#
# Instrumentations SHOULD use a gauge with type `double` and measure uptime in seconds as a floating point number with the highest precision available.
# The actual accuracy would depend on the instrumentation and operating system.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:326
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_UPTIME = T.let(T.unsafe(nil), String)

