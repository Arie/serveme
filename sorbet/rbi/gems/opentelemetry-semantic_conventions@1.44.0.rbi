# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/file/attributes.rb:58
OpenTelemetry::SemConv::Incubating::FILE::FILE_DIRECTORY = T.let(T.unsafe(nil), String)

# File extension, excluding the leading dot.
#
# When the filename has multiple extensions (example.tar.gz), only the last one should be captured ("gz", not "tar.gz").
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/file/attributes.rb:65
OpenTelemetry::SemConv::Incubating::FILE::FILE_EXTENSION = T.let(T.unsafe(nil), String)

# Name of the fork. A fork is additional data associated with a filesystem object.
#
# On Linux, a resource fork is used to store additional data with a filesystem object. A file always has at least one fork for the data portion, and additional forks may exist.
# On NTFS, this is analogous to an Alternate Data Stream (ADS), and the default data stream for a file is just called $DATA. Zone.Identifier is commonly used by Windows to track contents downloaded from the internet. An ADS is typically of the form: C:\path\to\filename.extension:some_fork_name, and some_fork_name is the value that should populate `fork_name`. `filename.extension` should populate `file.name`, and `extension` should populate `file.extension`. The full path, `file.path`, will include the fork name.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/file/attributes.rb:73
OpenTelemetry::SemConv::Incubating::FILE::FILE_FORK_NAME = T.let(T.unsafe(nil), String)

