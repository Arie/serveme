OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_MEMORY_LINUX_HUGEPAGES_LIMIT = T.let(T.unsafe(nil), String)

# System hugepage size in bytes.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:157
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_MEMORY_LINUX_HUGEPAGES_PAGE_SIZE = T.let(T.unsafe(nil), String)

# Number of reserved hugepages.
#
# Hugepages for which a commitment to allocate has been made, but no allocation has yet been made.
# This is reported as a separate metric rather than a `usage` state because reserved pages are already counted in `free` pages.
# They represent a subset of free pages that cannot be used for non-reserved allocations.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:166
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_MEMORY_LINUX_HUGEPAGES_RESERVED = T.let(T.unsafe(nil), String)

# The Linux HugePages memory state
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/attributes.rb:67
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_MEMORY_LINUX_HUGEPAGES_STATE = T.let(T.unsafe(nil), String)

# Number of surplus hugepages.
#
# Overcommitted hugepages beyond the persistent pool.
# This is reported as a separate metric rather than a `usage` state because surplus pages can be in either `used` or `free` state.
# Including them in `usage` would break the convention that `usage` states sum to the `limit`.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:175
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_MEMORY_LINUX_HUGEPAGES_SURPLUS = T.let(T.unsafe(nil), String)

