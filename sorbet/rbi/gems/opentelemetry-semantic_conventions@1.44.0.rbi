# @note Stability Level: stable
#
# @deprecated Now available in the stable namespace at {OpenTelemetry::SemConv::OTEL::OTEL_EVENT_NAME}.
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/otel/attributes.rb:61
OpenTelemetry::SemConv::Incubating::OTEL::OTEL_EVENT_NAME = T.let(T.unsafe(nil), String)

