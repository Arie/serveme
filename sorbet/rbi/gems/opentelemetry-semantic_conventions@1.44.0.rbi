# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/attributes.rb:72
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_MEMORY_LINUX_SLAB_STATE = T.let(T.unsafe(nil), String)

# Reports the memory used by the Linux kernel for managing caches of frequently used objects.
