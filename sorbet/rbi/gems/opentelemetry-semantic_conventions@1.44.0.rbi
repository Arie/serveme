# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/process/attributes.rb:116
OpenTelemetry::SemConv::Incubating::PROCESS::PROCESS_EXECUTABLE_BUILD_ID_PROFILING = T.let(T.unsafe(nil), String)

