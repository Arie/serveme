# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/file/attributes.rb:53
OpenTelemetry::SemConv::Incubating::FILE::FILE_CREATED = T.let(T.unsafe(nil), String)

# Directory where the file is located. It should include the drive letter, when appropriate.
