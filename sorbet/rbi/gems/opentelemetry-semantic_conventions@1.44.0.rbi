# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/faas/attributes.rb:142
OpenTelemetry::SemConv::Incubating::FAAS::FAAS_VERSION = T.let(T.unsafe(nil), String)

