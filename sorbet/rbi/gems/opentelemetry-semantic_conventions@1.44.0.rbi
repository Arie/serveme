#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:37
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_CPU_LOGICAL_COUNT = T.let(T.unsafe(nil), String)

