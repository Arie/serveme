OpenTelemetry::SemConv::Incubating::FILE::FILE_ACCESSED = T.let(T.unsafe(nil), String)

# Array of file attributes.
#
# Attributes names depend on the OS or file system. Here’s a non-exhaustive list of values expected for this attribute: `archive`, `compressed`, `directory`, `encrypted`, `execute`, `hidden`, `immutable`, `journaled`, `read`, `readonly`, `symbolic link`, `system`, `temporary`, `write`.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/file/attributes.rb:39
OpenTelemetry::SemConv::Incubating::FILE::FILE_ATTRIBUTES = T.let(T.unsafe(nil), String)

# Time when the file attributes or metadata was last changed, in ISO 8601 format.
#
# `file.changed` captures the time when any of the file's properties or attributes (including the content) are changed, while `file.modified` captures the timestamp when the file content is modified.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/file/attributes.rb:46
OpenTelemetry::SemConv::Incubating::FILE::FILE_CHANGED = T.let(T.unsafe(nil), String)

# Time when the file was created, in ISO 8601 format.
