# Total CPU time consumed.
#
# CPU time consumed by the specific container on all available CPU cores
#
# @note Stability Level: release_candidate
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/container/metrics.rb:32
OpenTelemetry::SemConv::Incubating::CONTAINER::CONTAINER_CPU_TIME = T.let(T.unsafe(nil), String)

# Container's CPU usage, measured in CPUs. Range from 0 to the number of allocatable CPUs.
#
# CPU usage of the specific container on all available CPU cores. It is calculated as the change in cumulative CPU time (container.cpu.time) over a measurement interval, divided by the elapsed time: usageCores = (cpuTimeEnd - cpuTimeStart) / elapsedSeconds
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/container/metrics.rb:39
OpenTelemetry::SemConv::Incubating::CONTAINER::CONTAINER_CPU_USAGE = T.let(T.unsafe(nil), String)

