# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:76
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_DISK_LIMIT = T.let(T.unsafe(nil), String)

# The number of disk reads/writes merged into single physical disk access operations.
