# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:24
module OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY; end

# The guid of the application.
#
# Application instrumentation should use the value from environment
# variable `VCAP_APPLICATION.application_id`. This is the same value as
# reported by `cf app <app-name> --guid`.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:34
OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY::CLOUDFOUNDRY_APP_ID = T.let(T.unsafe(nil), String)

# The index of the application instance. 0 when just one instance is active.
#
# CloudFoundry defines the `instance_id` in the [Loggregator v2 envelope](https://github.com/cloudfoundry/loggregator-api#v2-envelope).
# It is used for logs and metrics emitted by CloudFoundry. It is
# supposed to contain the application instance index for applications
# deployed on the runtime.
#
# Application instrumentation should use the value from environment
# variable `CF_INSTANCE_INDEX`.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:47
OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY::CLOUDFOUNDRY_APP_INSTANCE_ID = T.let(T.unsafe(nil), String)

# The name of the application.
#
# Application instrumentation should use the value from environment
# variable `VCAP_APPLICATION.application_name`. This is the same value
# as reported by `cf apps`.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:56
OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY::CLOUDFOUNDRY_APP_NAME = T.let(T.unsafe(nil), String)

# The guid of the CloudFoundry org the application is running in.
#
# Application instrumentation should use the value from environment
# variable `VCAP_APPLICATION.org_id`. This is the same value as
# reported by `cf org <org-name> --guid`.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:65
OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY::CLOUDFOUNDRY_ORG_ID = T.let(T.unsafe(nil), String)

# The name of the CloudFoundry organization the app is running in.
#
# Application instrumentation should use the value from environment
# variable `VCAP_APPLICATION.org_name`. This is the same value as
# reported by `cf orgs`.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:74
OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY::CLOUDFOUNDRY_ORG_NAME = T.let(T.unsafe(nil), String)

# The UID identifying the process.
#
# Application instrumentation should use the value from environment
# variable `VCAP_APPLICATION.process_id`. It is supposed to be equal to
# `VCAP_APPLICATION.app_id` for applications deployed to the runtime.
# For system components, this could be the actual PID.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:84
OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY::CLOUDFOUNDRY_PROCESS_ID = T.let(T.unsafe(nil), String)

# The type of process.
#
# CloudFoundry applications can consist of multiple jobs. Usually the
# main process will be of type `web`. There can be additional background
# tasks or side-cars with different process types.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:93
OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY::CLOUDFOUNDRY_PROCESS_TYPE = T.let(T.unsafe(nil), String)

# The guid of the CloudFoundry space the application is running in.
#
# Application instrumentation should use the value from environment
# variable `VCAP_APPLICATION.space_id`. This is the same value as
# reported by `cf space <space-name> --guid`.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:102
OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY::CLOUDFOUNDRY_SPACE_ID = T.let(T.unsafe(nil), String)

# The name of the CloudFoundry space the application is running in.
#
# Application instrumentation should use the value from environment
# variable `VCAP_APPLICATION.space_name`. This is the same value as
# reported by `cf spaces`.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:111
OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY::CLOUDFOUNDRY_SPACE_NAME = T.let(T.unsafe(nil), String)

# A guid or another name describing the event source.
#
# CloudFoundry defines the `source_id` in the [Loggregator v2 envelope](https://github.com/cloudfoundry/loggregator-api#v2-envelope).
# It is used for logs and metrics emitted by CloudFoundry. It is
# supposed to contain the component name, e.g. "gorouter", for
# CloudFoundry components.
#
# When system components are instrumented, values from the
# [Bosh spec](https://bosh.io/docs/jobs/#properties-spec)
# should be used. The `system.id` should be set to
# `spec.deployment/spec.name`.
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/cloudfoundry/attributes.rb:126
OpenTelemetry::SemConv::Incubating::CLOUDFOUNDRY::CLOUDFOUNDRY_SYSTEM_ID = T.let(T.unsafe(nil), String)

# A guid describing the concrete instance of the event source.
#
# CloudFoundry defines the `instance_id` in the [Loggregator v2 envelope](https://github.com/cloudfoundry/loggregator-api#v2-envelope).
# It is used for logs and metrics emitted by CloudFoundry. It is
# supposed to contain the vm ID for CloudFoundry components.
#
# When system components are instrumented, values from the
# [Bosh spec](https://bosh.io/docs/jobs/#properties-spec)
# should be used. The `system.instance.id` should be set to `spec.id`.
#
