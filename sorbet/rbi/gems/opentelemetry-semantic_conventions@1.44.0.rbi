#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/process/attributes.rb:87
OpenTelemetry::SemConv::Incubating::PROCESS::PROCESS_EXECUTABLE_BUILD_ID_GNU = T.let(T.unsafe(nil), String)

# The Go build ID as retrieved by `go tool buildid <go executable>`.
#
# @note Stability Level: release_candidate
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/process/attributes.rb:92
OpenTelemetry::SemConv::Incubating::PROCESS::PROCESS_EXECUTABLE_BUILD_ID_GO = T.let(T.unsafe(nil), String)

# Deterministic build ID for executables.
#
# GNU and Go build IDs may be stripped or unavailable in some environments
# (e.g., Alpine Linux, Docker images). This attribute provides a deterministic
# build ID computed by hashing the first and last 4096 bytes of the file
# along with its length:
# ```
# Input   ← Concat(File[:4096], File[-4096:], BigEndianUInt64(Len(File)))
# Digest  ← SHA256(Input)
# BuildID ← Digest[:16]
# ```
#
# The result is the first 16 bytes (128 bits) of the SHA256 digest,
# represented as a hex string.
#
# @note Stability Level: release_candidate
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/process/attributes.rb:110
OpenTelemetry::SemConv::Incubating::PROCESS::PROCESS_EXECUTABLE_BUILD_ID_HTLHASH = T.let(T.unsafe(nil), String)

# "Deprecated, use `process.executable.build_id.htlhash` instead."
