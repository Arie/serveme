# - Windows: "Avg. Disk sec/Read" perf counter multiplied by "Disk Reads/sec" perf counter (similar for Writes)
#
# @note Stability Level: development
#
# pkg:gem/opentelemetry-semantic_conventions#lib/opentelemetry/semconv/incubating/system/metrics.rb:91
OpenTelemetry::SemConv::Incubating::SYSTEM::SYSTEM_DISK_OPERATION_TIME = T.let(T.unsafe(nil), String)

