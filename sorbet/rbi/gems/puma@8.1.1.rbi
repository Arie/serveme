  # @example
  #   shutdown_debug
  #
  # @see force_shutdown_after
  #
  # pkg:gem/puma#lib/puma/dsl.rb:1432
  def shutdown_debug(val = T.unsafe(nil), on_force: T.unsafe(nil)); end

