  # pkg:gem/puma#lib/puma/server.rb:817
  def add_unix_listener(path, umask = T.unsafe(nil), mode = T.unsafe(nil), backlog = T.unsafe(nil)); end

  # pkg:gem/puma#lib/puma/server.rb:56
