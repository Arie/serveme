# pkg:gem/puma#lib/puma/client.rb:24
class Puma::ContinueRejected < ::StandardError
  # pkg:gem/puma#lib/puma/client.rb:27
  def initialize(response); end

  # pkg:gem/puma#lib/puma/client.rb:25
