# pkg:gem/stripe#lib/stripe/resources.rb:215
module Stripe::Identity; end

# A VerificationReport is the result of an attempt to collect and verify data from a user.
# The collection of verification checks performed is determined from the `type` and `options`
# parameters used. You can find the result of each verification check performed in the
# appropriate sub-resource: `document`, `id_number`, `selfie`.
#
# Each VerificationReport contains a copy of any data collected by the user as well as
# reference IDs which can be used to access collected images through the [FileUpload](https://docs.stripe.com/api/files)
# API. To configure and create VerificationReports, use the
# [VerificationSession](https://docs.stripe.com/api/identity/verification_sessions) API.
#
# Related guide: [Accessing verification results](https://docs.stripe.com/identity/verification-sessions#results).
#
# pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:17
class Stripe::Identity::VerificationReport < ::Stripe::APIResource
  extend ::Stripe::APIOperations::List

  # A string to reference this user. This can be a customer ID, a session ID, or similar, and can be used to reconcile this verification with your internal systems.
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:354
  sig { returns(T.nilable(String)) }
  def client_reference_id; end

  # Time at which the object was created. Measured in seconds since the Unix epoch.
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:356
  sig { returns(Integer) }
  def created; end

  # Result from a document check
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:358
  sig { returns(T.nilable(Document)) }
  def document; end

  # Result from a email check
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:360
  sig { returns(T.nilable(Email)) }
  def email; end

  # Unique identifier for the object.
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:362
  sig { returns(String) }
  def id; end

  # Result from an id_number check
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:364
  sig { returns(T.nilable(IdNumber)) }
  def id_number; end

  # If the object exists in live mode, the value is `true`. If the object exists in test mode, the value is `false`.
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:366
  sig { returns(T::Boolean) }
