# pkg:gem/stripe#lib/stripe/util.rb:6
module Stripe::Util
  class << self
    # pkg:gem/stripe#lib/stripe/util.rb:338
    def check_api_key!(key); end

    # pkg:gem/stripe#lib/stripe/util.rb:332
    def check_string_argument!(key); end

    # Converts a hash of fields or an array of hashes into a +StripeObject+ or
    # array of +StripeObject+s. These new objects will be created as a concrete
    # type as dictated by their `object` field (e.g. an `object` value of
    # `charge` would create an instance of +Charge+), but if `object` is not
    # present or of an unknown type, the newly created instance will fall back
    # to being a +StripeObject+.
    #
    # ==== Attributes
    #
    # * +data+ - Hash of fields and values to be converted into a StripeObject.
    # * +params+ - Params for +StripeObject+ like filters used in search that
    #   will be reused on subsequent API calls.
    # * +opts+ - Options for +StripeObject+ like an API key that will be reused
    #   on subsequent API calls.
    #
    # pkg:gem/stripe#lib/stripe/util.rb:109
    def convert_to_stripe_object(data, opts = T.unsafe(nil), api_mode: T.unsafe(nil), requestor: T.unsafe(nil), klass: T.unsafe(nil)); end

    # Converts a hash of fields or an array of hashes into a +StripeObject+ or
    # array of +StripeObject+s. These new objects will be created as a concrete
    # type as dictated by their `object` field (e.g. an `object` value of
    # `charge` would create an instance of +Charge+), but if `object` is not
    # present or of an unknown type, the newly created instance will fall back
    # to being a +StripeObject+.
    #
    # ==== Attributes
    #
    # * +data+ - Hash of fields and values to be converted into a StripeObject.
    # * +opts+ - Options for +StripeObject+ like an API key that will be reused
    #   on subsequent API calls.
    # * +last_response+ - The raw response associated with the object.
    # * +api_mode+ - The API mode to use when converting the object, either :v1 or :v2.
    # * +requestor+ - The requestor to use when constructing the object.
    # * +v2_deleted_object+ - If true, ignore the object tag for casting purposes
    # * +klass+ - The class to use for inner types
    #
    # pkg:gem/stripe#lib/stripe/util.rb:130
    def convert_to_stripe_object_with_params(data, params, opts = T.unsafe(nil), last_response = T.unsafe(nil), api_mode: T.unsafe(nil), requestor: T.unsafe(nil), v2_deleted_object: T.unsafe(nil), klass: T.unsafe(nil)); end

    # Adds a custom method to a resource class. This is used to add support for
    # non-CRUDL API requests, e.g. capturing charges. custom_method takes the
    # following parameters:
    # - name: the name of the custom method to create (as a symbol)
    # - http_verb: the HTTP verb for the API request (:get, :post, or :delete)
    # - http_path: the path to append to the resource's URL. If not provided,
    #              the name is used as the path
    # - resource: the resource implementation class
    # - target: the class that custom static method will be added to
    #
    # For example, this call:
    #     custom_method :capture, http_verb: post
    # adds a `capture` class method to the resource class that, when called,
    # will send a POST request to `/v1/<object_name>/capture`.
    # TODO: are we comfortable with deleting this?
    #
    # pkg:gem/stripe#lib/stripe/util.rb:63
    def custom_method(resource, target, name, http_verb, http_path); end

    # Encodes a hash of parameters in a way that's suitable for use as query
    # parameters in a URI or as form parameters in a request body. This mainly
    # involves escaping special characters from parameter keys and values (e.g.
    # `&`).
    #
    # pkg:gem/stripe#lib/stripe/util.rb:238
    def encode_parameters(params, api_mode); end

    # pkg:gem/stripe#lib/stripe/util.rb:40
    def event_notification_classes; end

    # pkg:gem/stripe#lib/stripe/util.rb:254
    def flatten_params(params, api_mode, parent_key = T.unsafe(nil)); end

    # pkg:gem/stripe#lib/stripe/util.rb:273
    def flatten_params_array(value, api_mode, calculated_key); end

    # Returns either v1 or v2 as api_mode based on the given path
    #
    # pkg:gem/stripe#lib/stripe/util.rb:411
    def get_api_mode(path); end

    # pkg:gem/stripe#lib/stripe/util.rb:204
    def log_debug(message, data = T.unsafe(nil)); end

    # pkg:gem/stripe#lib/stripe/util.rb:184
    def log_error(message, data = T.unsafe(nil)); end

    # pkg:gem/stripe#lib/stripe/util.rb:194
    def log_info(message, data = T.unsafe(nil)); end

    # `Time.now` can be unstable in cases like an administrator manually
    # updating its value or a reconcilation via NTP. For this reason, prefer
    # the use of the system's monotonic clock especially where comparing times
    # to calculate an elapsed duration.
    #
    # Shortcut for getting monotonic time, mostly for purposes of line length
    # and test stubbing. Returns time in seconds since the event used for
    # monotonic reference purposes by the platform (e.g. system boot time).
    #
    # pkg:gem/stripe#lib/stripe/util.rb:296
    def monotonic_time; end

    # Normalizes header keys so that they're all lower case and each
    # hyphen-delimited section starts with a single capitalized letter. For
    # example, `request-id` becomes `Request-Id`. This is useful for extracting
    # certain key values when the user could have set them with a variety of
    # diffent naming schemes.
    #
    # pkg:gem/stripe#lib/stripe/util.rb:349
    def normalize_headers(headers); end

    # pkg:gem/stripe#lib/stripe/util.rb:300
    def normalize_id(id); end

    # The secondary opts argument can either be a string or hash
    # Turn this value into an api_key and a set of headers
    #
    # pkg:gem/stripe#lib/stripe/util.rb:312
    def normalize_opts(opts); end

    # pkg:gem/stripe#lib/stripe/util.rb:28
    def object_classes; end

    # pkg:gem/stripe#lib/stripe/util.rb:44
    def object_name_matches_class?(object_name, klass); end

    # pkg:gem/stripe#lib/stripe/util.rb:7
    def objects_to_ids(obj, serialize_empty: T.unsafe(nil)); end

    # Generates a Dashboard link to inspect a request ID based off of a request
    # ID value and an API key, which is used to attempt to extract whether the
    # environment is livemode or testmode.
    #
    # pkg:gem/stripe#lib/stripe/util.rb:361
    def request_id_dashboard_url(request_id, api_key); end

    # Constant time string comparison to prevent timing attacks
    # Code borrowed from ActiveSupport
    #
    # pkg:gem/stripe#lib/stripe/util.rb:368
    def secure_compare(str_a, str_b); end

    # pkg:gem/stripe#lib/stripe/util.rb:214
    def symbolize_names(object); end

    # Encodes a string in a way that makes it suitable for use in a set of
    # query parameters in a URI or in a set of form parameters in a request
    # body.
    #
    # pkg:gem/stripe#lib/stripe/util.rb:246
    def url_encode(key); end

    # pkg:gem/stripe#lib/stripe/util.rb:36
    def v2_event_classes; end

    # pkg:gem/stripe#lib/stripe/util.rb:32
    def v2_object_classes; end

    # Return false for strings that are invalid variable names
    # Does NOT expect there to be a preceding '@' for instance variables
    #
    # pkg:gem/stripe#lib/stripe/util.rb:328
    def valid_variable_name?(key); end

    # Asserts that a request path is origin-relative: that it begins with a
    # single "/" and carries no scheme, authority or userinfo.
    #
    # The absolute URL is built by concatenating a base address onto this path,
    # and no base address ends in a slash. A path like "@evil.example/v1/x" or
    # ".evil.example/v1/x" would modify the resulting host and direct the request
    # (including the API key) to a non-Stripe host.
    #
    # Because some relative urls arrive from potentially untrusted sources (like
    # webhook bodies), we have to be a little defensive.
    #
    # So, we require that a path starts with a leading slash and that URI.parse
    # finds no scheme or authority in it.
    #
    # pkg:gem/stripe#lib/stripe/util.rb:391
    def validate_path!(path); end

    private

    # Uses an ANSI escape code to colorize text if it's going to be sent to a
    # TTY.
    #
    # pkg:gem/stripe#lib/stripe/util.rb:438
    def colorize(val, color, isatty); end

    # Turns an integer log level into a printable name.
    #
    # pkg:gem/stripe#lib/stripe/util.rb:450
    def level_name(level); end

    # pkg:gem/stripe#lib/stripe/util.rb:460
    def log_internal(message, data = T.unsafe(nil), color:, level:, logger:, out:); end

    # Wraps a value in double quotes if it looks sufficiently complex so that
    # it can be read by logfmt parsers.
    #
    # pkg:gem/stripe#lib/stripe/util.rb:492
    def wrap_logfmt_value(val); end
  end
end

