  # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:66
  def coerce_decimal_string(value, direction); end

  # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:111
  def coerce_discriminated_union(value, discriminator, variants, direction); end

  # Coerce all fields in a hash according to a schema map.
  #
  # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:35
  def coerce_fields(hash, schema, direction:); end

  # --- leaf coercions ---
  #
  # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:47
  def coerce_int64_string(value, direction); end

  # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:105
  def coerce_object(value, fields_schema, direction); end

  # Coerce a single value based on its field encoding schema.
  # direction: :encode (request: native → wire) or :decode (response: wire → native)
  #
  # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:19
  def coerce_value(value, encoding, direction:); end

  class << self
    # --- composite coercions ---
    #
    # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:88
    def coerce_composite(value, encoding, direction); end

    # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:66
    def coerce_decimal_string(value, direction); end

    # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:111
    def coerce_discriminated_union(value, discriminator, variants, direction); end

    # Coerce all fields in a hash according to a schema map.
    #
    # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:35
    def coerce_fields(hash, schema, direction:); end

    # --- leaf coercions ---
    #
    # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:47
    def coerce_int64_string(value, direction); end

    # pkg:gem/stripe#lib/stripe/v2_type_coercion.rb:105
    def coerce_object(value, fields_schema, direction); end

    # Coerce a single value based on its field encoding schema.
