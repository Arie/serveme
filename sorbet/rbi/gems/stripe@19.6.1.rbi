      metadata: T.nilable(T.any(String, T::Hash[String, String])),
      phases: T.nilable(T::Array[::Stripe::SubscriptionScheduleUpdateParams::Phase]),
      proration_behavior: T.nilable(String)
    ).void
  end
  def initialize(default_settings: nil, end_behavior: nil, expand: nil, metadata: nil, phases: nil, proration_behavior: nil); end

