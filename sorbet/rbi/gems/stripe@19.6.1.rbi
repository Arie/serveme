  #
  # pkg:gem/stripe#lib/stripe/services/subscription_service.rb:28
  sig do
    params(
      params: T.any(::Stripe::SubscriptionCreateParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(::Stripe::Subscription)
  end
  def create(params = {}, opts = {}); end

