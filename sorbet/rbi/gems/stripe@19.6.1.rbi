    params(
      _default_settings: T.nilable(::Stripe::SubscriptionScheduleUpdateParams::DefaultSettings)
    ).returns(T.nilable(::Stripe::SubscriptionScheduleUpdateParams::DefaultSettings))
  end
  def default_settings=(_default_settings); end

