  # pkg:gem/stripe#lib/stripe/services/subscription_service.rb:41
  sig do
    params(
      subscription_exposed_id: String,
      params: T.any(::Stripe::SubscriptionDeleteDiscountParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(::Stripe::Discount)
  end
  def delete_discount(subscription_exposed_id, params = {}, opts = {}); end

