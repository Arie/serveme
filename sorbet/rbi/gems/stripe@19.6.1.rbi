class Stripe::SubscriptionScheduleUpdateParams < ::Stripe::RequestParams
  # pkg:gem/stripe#lib/stripe/params/subscription_schedule_update_params.rb:645
  sig do
    params(
      default_settings: T.nilable(::Stripe::SubscriptionScheduleUpdateParams::DefaultSettings),
