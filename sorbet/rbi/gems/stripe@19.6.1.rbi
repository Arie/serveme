  def boundary; end

  # Finalizes the object by writing the final boundary.
  #
  # pkg:gem/stripe#lib/stripe/multipart_encoder.rb:59
  def close; end

  # Gets the value including boundary that should be put into a multipart
  # request's `Content-Type`.
